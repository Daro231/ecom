# Copy to .env, fill in, and load it into the shell before starting the app:  set -a; . ./.env; set +a
# Never commit .env.
# Delete (or comment out) the lines you do not need: an empty value overrides the built-in default.

# Database (dev profile)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Security
JWT_SECRET=

# KHQR: mock | bakong
KHQR_MODE=

# Bakong (required when KHQR_MODE=bakong)
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_BASE_URL=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=
BAKONG_CURRENCY=
BAKONG_KHR_PER_USD=

# Minutes after which an unpaid KHQR order is cancelled (0 = never)
KHQR_AUTO_CANCEL_MINUTES=
